{
  "manifest_version": 3,
  "name": "Bharat Translate+",
  "short_name": "Bharat T+",
  "version": "0.1.0",
  "author": "Shashwat Mishra",
  "description": "Translate and simplify any web page into Hindi, Marathi, Tamil and more. Free, private, on-device AI.",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "scripting", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Bharat Translate+",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
